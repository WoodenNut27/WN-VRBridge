{
    "driver_wnvrbridge": {
        "enable": true,
        "requireHostApproval": true,
        "autoStopSteamVr": false,
        "audioEnabled": true,
        "micToPc": true,
        "muteSpeakerWhileConnected": true,
        "adapterIndex": -1,
        "dumpFrame": false,
        "foveatedEncoding": true,
        "foveationCenterWidth": 0.45,
        "foveationCenterHeight": 0.40,
        "foveationCenterExtendUp": 0.10,
        "foveationEdgeRatioX": 4.0,
        "foveationEdgeRatioY": 5.0,
        "bitrateMbps": 80,
        "dumpVideoSeconds": 0,
        "renderWidth": 2064,
        "renderHeight": 2208,
        "displayFrequency": 72.0,
        "pacingRatio": 0.0,
        "framePoseDelayMs": 2,
        "controllerPitchOffsetDeg": -20.6,
        "controllerYawOffsetDeg": 0.0,
        "controllerRollOffsetDeg": 0.0,
        "controllerOffsetX": 0.007,
        "controllerOffsetY": -0.0342,
        "controllerOffsetZ": -0.0961,
        "bindAddress": "0.0.0.0",
        "port": 9944,
        "clientTimeoutMs": 2000
    }
}
